(kicad_pcb (version 6) (host pcbnew 6.0)
  (general
    (thickness 1.6)
  )
  (page A4)
  (layers (0 F.Cu) (31 B.Cu) (32 B.Adhes) (33 F.Adhes) (34 Edge.Cuts))

  (setup
    (last_trace_width 0.25)
  )

  (net_class Default (clearance 0.2) (trace_width 0.25) (via_dia 0.6) (via_drill 0.4))

  (net 0 "3V3")
  (net 1 "GND")
  (net 2 "I2C_SDA")
  (net 3 "I2C_SCL")

  (module Espressif:ESP32-S3-WROOM-1U (layer F.Cu) (tedit 0)
    (at 12 25)
    (descr "ESP32-S3-WROOM-1U Module")
    (fp_text reference U1 (at 0 3.5) (layer F.SilkS))
    (fp_text value ESP32-S3-WROOM-1U (at 0 -3.5) (layer F.Fab))
  )

  (gr_line (start 0 0) (end 50 0) (layer Edge.Cuts) (width 0.15))
  (gr_line (start 50 0) (end 50 40) (layer Edge.Cuts) (width 0.15))
  (gr_line (start 50 40) (end 0 40) (layer Edge.Cuts) (width 0.15))
  (gr_line (start 0 40) (end 0 0) (layer Edge.Cuts) (width 0.15))
)
